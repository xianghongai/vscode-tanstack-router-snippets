{
	"TanStack Router form route with server function (TypeScript)": {
		"prefix": ["routeFormSubmit", "rfs"],
		"isFileTemplate": true,
		"body": [
			"import { createFileRoute, redirect, useRouter } from '@tanstack/react-router';",
			"import { createServerFn, useServerFn } from '@tanstack/react-start';",
			"import { z } from 'zod';",
			"",
			"const ${1:postSchema} = z.object({",
			"  title: z.string().min(1),",
			"});",
			"",
			"const ${2:createPost} = createServerFn({ method: 'POST' })",
			"  .validator(${1})",
			"  .handler(async ({ data }) => {",
			"    $0",
			"    throw redirect({ to: '${3:/posts}' });",
			"  });",
			"",
			"export const Route = createFileRoute('${4:/posts/new}')({",
			"  component: ${5:NewPostPage},",
			"});",
			"",
			"function ${5}() {",
			"  const router = useRouter();",
			"  const submit = useServerFn(${2});",
			"",
			"  return (",
			"    <form",
			"      onSubmit={async (event) => {",
			"        event.preventDefault();",
			"        const form = new FormData(event.currentTarget);",
			"        await submit({ data: { title: String(form.get('title')) } });",
			"        await router.invalidate();",
			"      }}",
			"    >",
			"      <input name=\"title\" />",
			"      <button type=\"submit\">${6:Save}</button>",
			"    </form>",
			"  );",
			"}"
		],
		"description": "Complete route that validates a submission on the server, redirects when it succeeds and refreshes the loaders behind it. Requires @tanstack/react-router, @tanstack/react-start and zod.\n\n完整的路由：在服务端校验提交、成功后重定向，并刷新其后的 loader；需要 @tanstack/react-router、@tanstack/react-start 与 zod。",
		"scope": "typescriptreact"
	}
}
