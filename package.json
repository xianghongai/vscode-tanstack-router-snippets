{
  "name": "vscode-tanstack-router-snippets",
  "displayName": "TanStack Router Snippets",
  "version": "1.1.0",
  "description": "Snippets for TanStack Router: file routes, search params, loaders, router context, TanStack Start and Query integration. TanStack Router 高频片段。",
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "react",
    "routing",
    "snippets",
    "tanstack-query",
    "tanstack-router",
    "tanstack-start"
  ],
  "homepage": "https://github.com/xianghongai/vscode-tanstack-router-snippets/",
  "bugs": {
    "url": "https://github.com/xianghongai/vscode-tanstack-router-snippets/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xianghongai/vscode-tanstack-router-snippets/blob/master/README.md"
  },
  "publisher": "NicholasHsiang",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "clean": "rimraf --glob \"*.vsix\" snippets",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint scripts tests",
    "test": "vitest run",
    "vsce:package": "vsce package --no-dependencies",
    "vsce:publish": "vsce publish --no-dependencies",
    "vscode:prepublish": "pnpm run clean && pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@vscode/vsce": "^3.9.2",
    "dotenv": "^17.4.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.81.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "contributes": {
    "snippets": [
      {
        "path": "./snippets/index.code-snippets"
      }
    ]
  },
  "icon": "art/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "packageManager": "pnpm@11.25.0"
}
